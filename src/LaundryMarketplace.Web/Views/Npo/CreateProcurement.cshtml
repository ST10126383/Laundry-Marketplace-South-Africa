@{
    ViewData["Title"] = "Create Uniform Procurement";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">New Uniform Procurement</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateProcurement" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier Name</label>
                        <input type="text" name="supplierName" class="form-control" required placeholder="e.g. Gauteng Textile Co." />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Quantity (uniforms)</label>
                            <input type="number" name="uniformQuantity" class="form-control" min="1" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Unit Cost (R)</label>
                            <input type="number" name="unitCost" class="form-control" step="0.01" min="0.01" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Create Procurement & Deduct Funds</button>
                </form>
            </div>
        </div>
    </div>
</div>
