@{
    ViewData["Title"] = "Error";
    var message = Context.Request.Query["message"].ToString();
}

<div class="text-center py-5">
    <h1 class="display-4 text-danger">Something went wrong</h1>
    <p class="lead">We apologise for the inconvenience.</p>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-warning d-inline-block">
            @message
        </div>
    }
    <p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return Home</a>
    </p>
</div>
